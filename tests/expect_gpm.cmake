# Drives gpm scenarios in a scratch directory.
# Required: -DPKG=<exe> -DSCENARIO=<name> -DWORK=<dir>
# Optional: -DFIXTURE=<dir> copied into WORK before running.

if(NOT DEFINED PKG OR NOT DEFINED SCENARIO OR NOT DEFINED WORK)
  message(FATAL_ERROR "expect_gpm.cmake requires PKG, SCENARIO, and WORK")
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
if(DEFINED FIXTURE AND NOT "${FIXTURE}" STREQUAL "")
  file(COPY "${FIXTURE}/" DESTINATION "${WORK}")
endif()

function(run_pkg RESULT_VAR)
  execute_process(
    COMMAND "${PKG}" ${ARGN}
    WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout_text
    ERROR_VARIABLE stderr_text)
  set(${RESULT_VAR} "${result}" PARENT_SCOPE)
  set(last_stdout "${stdout_text}" PARENT_SCOPE)
  set(last_stderr "${stderr_text}" PARENT_SCOPE)
endfunction()

function(require_ok WHAT)
  if(NOT "${${WHAT}}" STREQUAL "0")
    message(FATAL_ERROR "${WHAT} failed (exit ${${WHAT}}): ${last_stderr}")
  endif()
endfunction()

function(require_fail WHAT EXPECT_TEXT)
  if("${${WHAT}}" STREQUAL "0")
    message(FATAL_ERROR "${WHAT} unexpectedly succeeded")
  endif()
  if(NOT "${last_stderr}" MATCHES "${EXPECT_TEXT}")
    message(FATAL_ERROR "${WHAT} stderr '${last_stderr}' did not match '${EXPECT_TEXT}'")
  endif()
endfunction()

if(SCENARIO STREQUAL "init")
  run_pkg(INIT_RESULT init)
  require_ok(INIT_RESULT)
  if(NOT EXISTS "${WORK}/genesis.json")
    message(FATAL_ERROR "init did not create genesis.json")
  endif()
  file(READ "${WORK}/genesis.json" manifest_text)
  if(NOT manifest_text MATCHES "\"name\": \"@my-org/my-project\"")
    message(FATAL_ERROR "init manifest missing expected name: ${manifest_text}")
  endif()
  run_pkg(INIT_AGAIN_RESULT init)
  require_fail(INIT_AGAIN_RESULT "already exists")
  run_pkg(CHECK_RESULT check)
  require_ok(CHECK_RESULT)
  if(NOT last_stdout MATCHES "genesis.json is valid")
    message(FATAL_ERROR "check output unexpected: ${last_stdout}")
  endif()
elseif(SCENARIO STREQUAL "check_valid" OR SCENARIO STREQUAL "check_no_lockfile")
  run_pkg(CHECK_RESULT check)
  require_ok(CHECK_RESULT)
elseif(SCENARIO STREQUAL "check_malformed")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "gpm:")
elseif(SCENARIO STREQUAL "check_missing_manifest")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "gpm:")
elseif(SCENARIO STREQUAL "check_invalid_manifest")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "gpm:")
elseif(SCENARIO STREQUAL "check_invalid_name")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "'@author/name'")
elseif(SCENARIO STREQUAL "check_invalid_lockfile")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "Lockfile package 'util' is invalid")
elseif(SCENARIO STREQUAL "remove")
  run_pkg(REMOVE_RESULT remove util)
  require_ok(REMOVE_RESULT)
  if(NOT last_stdout MATCHES "Removed util")
    message(FATAL_ERROR "remove output unexpected: ${last_stdout}")
  endif()
  file(READ "${WORK}/genesis.json" manifest_text)
  if(manifest_text MATCHES "util")
    message(FATAL_ERROR "manifest still references util: ${manifest_text}")
  endif()
  if(NOT manifest_text MATCHES "nativeExtensions")
    message(FATAL_ERROR "manifest rewrite dropped nativeExtensions: ${manifest_text}")
  endif()
  file(READ "${WORK}/genesis.lock.json" lockfile_text)
  if(lockfile_text MATCHES "util")
    message(FATAL_ERROR "lockfile still references util: ${lockfile_text}")
  endif()
  if(EXISTS "${WORK}/.genesis/packages/util")
    message(FATAL_ERROR "installed package directory was not removed")
  endif()
  run_pkg(CHECK_RESULT check)
  require_ok(CHECK_RESULT)
elseif(SCENARIO STREQUAL "remove_missing_alias")
  run_pkg(REMOVE_RESULT remove ghost)
  require_fail(REMOVE_RESULT "No dependency named 'ghost'")
elseif(SCENARIO STREQUAL "tree")
  run_pkg(TREE_RESULT tree)
  require_ok(TREE_RESULT)
  foreach(_expected IN ITEMS
      "my-app@0.1.0" "util@1.0.0" "json@2.1.0" "web@2.0.0"
      "(deduped)" "(not installed)" "Extraneous lockfile packages"
      "orphan@0.1.0")
    string(FIND "${last_stdout}" "${_expected}" _found)
    if(_found EQUAL -1)
      message(FATAL_ERROR "tree output missing '${_expected}': ${last_stdout}")
    endif()
  endforeach()
elseif(SCENARIO STREQUAL "check_trust_fields")
  run_pkg(CHECK_RESULT check)
  require_ok(CHECK_RESULT)
elseif(SCENARIO STREQUAL "check_bad_trust_keyid")
  run_pkg(CHECK_RESULT check)
  require_fail(CHECK_RESULT "keyId does not match")
elseif(SCENARIO STREQUAL "keygen_sign_verify")
  # Isolate key storage, then exercise the full signing round-trip:
  # keygen -> sign an archive -> verify ok / wrong metadata / tamper.
  set(ENV{GPM_KEYS_DIR} "${WORK}/keys")
  run_pkg(KEYGEN_RESULT keygen)
  require_ok(KEYGEN_RESULT)
  if(NOT last_stdout MATCHES "publicKey: +[A-Za-z0-9_-]+")
    message(FATAL_ERROR "keygen output missing publicKey: ${last_stdout}")
  endif()
  string(REGEX MATCH "publicKey: +([A-Za-z0-9_-]+)" _ "${last_stdout}")
  set(test_public_key "${CMAKE_MATCH_1}")
  file(GLOB key_files "${WORK}/keys/*.key")
  list(LENGTH key_files key_count)
  if(NOT key_count EQUAL 1)
    message(FATAL_ERROR "expected exactly one key file, got ${key_count}")
  endif()
  set(key_file "${key_files}")
  file(WRITE "${WORK}/pkg-1.0.0.tar.gz" "fake archive bytes\n")
  run_pkg(SIGN_RESULT sign --key "${key_file}" --alias widgets
          --version 1.0.0 "${WORK}/pkg-1.0.0.tar.gz")
  require_ok(SIGN_RESULT)
  if(NOT EXISTS "${WORK}/pkg-1.0.0.tar.gz.sig")
    message(FATAL_ERROR "sign did not write <archive>.sig")
  endif()
  file(READ "${WORK}/pkg-1.0.0.tar.gz.sig" sig_text)
  if(NOT sig_text MATCHES "GENESIS-SIG-1" OR
     NOT sig_text MATCHES "alg: ed25519")
    message(FATAL_ERROR "signature envelope malformed: ${sig_text}")
  endif()
  run_pkg(VERIFY_RESULT verify --key "${key_file}" --alias widgets
          --version 1.0.0 "${WORK}/pkg-1.0.0.tar.gz")
  require_ok(VERIFY_RESULT)
  if(NOT last_stdout MATCHES "Verified widgets signature")
    message(FATAL_ERROR "verify output unexpected: ${last_stdout}")
  endif()
  run_pkg(VERIFY_PUB_RESULT verify --pubkey "${test_public_key}"
          --alias widgets --version 1.0.0 "${WORK}/pkg-1.0.0.tar.gz")
  require_ok(VERIFY_PUB_RESULT)
  # Wrong alias changes the canonical payload: must fail.
  run_pkg(VERIFY_ALIAS_RESULT verify --key "${key_file}" --alias gadgets
          --version 1.0.0 "${WORK}/pkg-1.0.0.tar.gz")
  require_fail(VERIFY_ALIAS_RESULT "verification failed")
  # Tampering with the archive invalidates the signature.
  file(APPEND "${WORK}/pkg-1.0.0.tar.gz" "tampered\n")
  run_pkg(VERIFY_TAMPER_RESULT verify --key "${key_file}" --alias widgets
          --version 1.0.0 "${WORK}/pkg-1.0.0.tar.gz")
  require_fail(VERIFY_TAMPER_RESULT "verification failed")
  # A keyId that does not match the public key is rejected by --pubkey
  # verification as well (envelope keyId vs derived keyId).
  run_pkg(VERIFY_NOSIG_RESULT verify --key "${key_file}" --alias widgets
          --version 1.0.0 "${WORK}/missing.tar.gz")
  require_fail(VERIFY_NOSIG_RESULT "gpm:")
else()
  message(FATAL_ERROR "Unknown scenario '${SCENARIO}'")
endif()
